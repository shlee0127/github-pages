<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>이미지 리사이징 및 저장</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 20px;
        }
        #image-preview {
            margin-top: 20px;
        }
        .image-container {
            display: inline-block;
            margin: 10px;
            text-align: center;
        }
        input[type="number"], input[type="file"] {
            margin-top: 10px;
        }
        .file-info {
            margin-top: 10px;
        }
        .image-dimensions {
            margin-top: 5px;
            font-size: 0.9em;
            color: gray;
        }
    </style>
</head>
<body>

    <h1>이미지 리사이징 및 저장</h1>

    <!-- 이미지 업로드 -->
    <input type="file" id="image-input" accept="image/*" multiple>
    
    <!-- 가로, 세로 크기 조정 -->
    <div>
        <label for="resize-width">가로 크기 (픽셀): </label>
        <input type="number" id="resize-width" min="10" max="1000" value="300">
        <br>
        <label for="resize-height">세로 크기 (픽셀): </label>
        <input type="number" id="resize-height" min="10" max="1000" value="300">
    </div>

    <!-- 이미지 미리보기 -->
    <div id="image-preview"></div>

    <!-- 저장 버튼 -->
    <button id="save-images">리사이즈된 이미지 저장</button>

    <script>
        const imageInput = document.getElementById('image-input');
        const resizeWidth = document.getElementById('resize-width');
        const resizeHeight = document.getElementById('resize-height');
        const imagePreview = document.getElementById('image-preview');
        const saveImagesButton = document.getElementById('save-images');

        let uploadedImages = [];

        // 여러 이미지 파일 업로드
        imageInput.addEventListener('change', (event) => {
            const files = event.target.files;
            imagePreview.innerHTML = '';  // 기존 미리보기 이미지 삭제
            uploadedImages = [];

            Array.from(files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const imgElement = document.createElement('img');
                    imgElement.src = e.target.result;
                    imgElement.style.maxWidth = '100%';
                    imgElement.style.height = 'auto';
                    imgElement.classList.add('uploaded-image');

                    // 이미지 로드 후 가로/세로 크기 표시
                    imgElement.onload = function() {
                        const width = imgElement.width;
                        const height = imgElement.height;

                        // 이미지 컨테이너 만들기
                        const container = document.createElement('div');
                        container.classList.add('image-container');
                        container.appendChild(imgElement);

                        // 파일 크기 및 이미지 크기 정보 표시
                        const fileInfo = document.createElement('div');
                        fileInfo.classList.add('file-info');
                        fileInfo.textContent = `파일 크기: ${(file.size / 1024).toFixed(2)} KB`;
                        container.appendChild(fileInfo);

                        const imageDimensions = document.createElement('div');
                        imageDimensions.classList.add('image-dimensions');
                        imageDimensions.textContent = `원본 크기: ${width} x ${height} 픽셀`;
                        container.appendChild(imageDimensions);

                        imagePreview.appendChild(container);

                        uploadedImages.push({
                            file: file,
                            imgElement: imgElement,
                        });

                        // 리사이즈 초기 값 설정
                        updateImageSize(imgElement);
                    };
                };
                reader.readAsDataURL(file);
            });
        });

        // 크기 조정 입력값 변경 시 이미지 크기 업데이트
        function updateImageSize(imgElement) {
            const width = resizeWidth.value;
            const height = resizeHeight.value;
            imgElement.style.width = `${width}px`;
            imgElement.style.height = `${height}px`;
        }

        // 가로/세로 크기 입력 값 변경 시 이미지 크기 업데이트
        resizeWidth.addEventListener('input', () => {
            const images = document.querySelectorAll('.uploaded-image');
            images.forEach(image => updateImageSize(image));
        });

        resizeHeight.addEventListener('input', () => {
            const images = document.querySelectorAll('.uploaded-image');
            images.forEach(image => updateImageSize(image));
        });

        // 이미지 저장 버튼 클릭 이벤트
        saveImagesButton.addEventListener('click', () => {
            uploadedImages.forEach(({ file, imgElement }) => {
                // Canvas를 사용하여 이미지를 리사이즈한 후 저장
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                const width = resizeWidth.value;
                const height = resizeHeight.value;

                // 이미지 크기를 리사이즈하여 그리기
                canvas.width = width;
                canvas.height = height;
                ctx.drawImage(imgElement, 0, 0, width, height);

                // Blob으로 변환하여 다운로드 링크 생성
                canvas.toBlob((blob) => {
                    const link = document.createElement('a');
                    const filename = file.name;  // 원본 파일명 그대로 사용
                    link.href = URL.createObjectURL(blob);
                    link.download = filename;
                    link.click();
                }, 'image/jpeg');
            });
        });
    </script>

</body>
</html>
